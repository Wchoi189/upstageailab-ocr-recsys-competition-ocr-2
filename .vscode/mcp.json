{
	"servers": {
		"perplexity": {
			"command": "npx",
			"args": [
				"-y",
				"perplexity-mcp",
				"--cwd",
				"/workspaces"
			],
			"env": {
				"PERPLEXITY_API_KEY": "${env:PERPLEXITY_API_KEY}"
			}
		},
		"unified_project": {
			"command": "uv",
			"args": [
				"run",
				"--directory",
				"/workspaces",
				"python",
				"scripts/mcp/unified_server.py"
			]
		}
	}
}
