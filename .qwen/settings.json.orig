{
  "general": {
    "checkpointing": {
      "enabled": true
    }
  },
  "ui": {
    "showMemoryUsage": true
  },
  "telemetry": {
    "enabled": false
  },
  "tools": {
    "approvalMode": "yolo"
  },
  "context": {
    "fileFiltering": {
      "respectGitIgnore": true,
      "respectQwenIgnore": true,
      "context_aware_loading": true,
      "includePatterns": [
        "**/pyproject.toml",
        "**/AGENTS.yaml",
        "**/AGENTS.md",
        "**/README.md",
        "**/.qwen/QWEN.md",
        "**/AgentQMS/**/*",
        "**/ocr/**/*",
        "**/configs/**/*",
        "**/dev_tools/project_compass/**/*",
        "**/scripts/**/*",
        "**/runners/**/*",
        "**/bin/**/*",
        "**/Makefile",
        "**/package.json",
        "**/pyproject.toml",
        "**/dev_tools/experiment_manager/**/*",
        "**/dev_tools/agent_debug_toolkit/**/*",
        "**/dev_tools/airflow_batch_processor/**/*",
        "**/analysis/**/*",
        "**/apps/**/*",
        "**/packages/**/*",
        "**/tests/**/*"
      ],
      "excludePatterns": [
        "**/node_modules/**",
        "**/.git/**",
        "**/logs/**",
        "**/outputs/**",
        "**/data/**",
        "**/__pycache__/**",
        "**/*.pyc",
        "**/.pytest_cache/**",
        "**/dist/**",
        "**/build/**",
        "**/venv/**",
        "**/.venv/**",
        "**/archive/**",
        "**/_*/**",
        "**/docs/assets/**",
        "**/docs/generated/**",
        "**/dev_tools/experiment_manager/experiments/**/outputs/**",
        "**/dev_tools/experiment_manager/experiments/**/checkpoints/**",
        "**/dev_tools/experiment_manager/experiments/**/__pycache__/**",
        "**/AgentQMS/standards/tier3-agents/claude/**/*"
      ]
    },
    "includeDirectories": [
      "dev_tools/airflow_batch_processor"
    ],
    "loadMemoryFromIncludeDirectories": false,
    "discoveryMaxDirs": 15,
    "importFormat": "tree"
  },
  "$version": 2,
  "mcpServers": {
    "unified_project": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/workspaces",
        "python",
        "scripts/mcp/unified_server.py"
      ]
    },
    "perplexity": {
      "command": "npx",
      "args": [
        "-y",
        "perplexity-mcp"
      ],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    }
  }
}
